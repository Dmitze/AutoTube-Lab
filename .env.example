# YTAIMBot Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# =============================================
# CORE PIPELINE
# =============================================
# false = реальна публікація на YouTube
YTAIMBOT_DRY_RUN=true
YTAIMBOT_SEED=42
YTAIMBOT_DATA_DIR=./data

# =============================================
# TREND ADAPTERS (Phase 1)
# =============================================
# YouTube Data API v3 (отримати: console.cloud.google.com)
# Порожньо = синтетичні дані
YOUTUBE_API_KEY=

# Google Trends geo (US, UA, GB, DE...)
# Порожньо = вимкнено Google Trends
GOOGLE_TRENDS_GEO=US

# Вага адаптерів: GoogleTrends,YouTube (через кому)
ADAPTER_WEIGHTS=1.0,1.0

# TTL кешу трендів (секунди)
TREND_CACHE_TTL=900

# =============================================
# LLM (Phase 2)
# =============================================
# Варіант A: Groq API (безкоштовно, рекомендовано)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Варіант B: Ollama на VPS (потрібно 4GB RAM)
# OLLAMA_URL=http://ollama:11434
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2:3b

# =============================================
# TTS (Phase 2)
# =============================================
TTS_LANGUAGE=uk
TTS_VOICE=uk-UA-OstapNeural

# =============================================
# PUBLISHING (Phase 4)
# =============================================
YOUTUBE_CLIENT_SECRET_PATH=
MAX_UPLOADS_PER_DAY=0

# =============================================
# MONITORING (Phase 7)
# =============================================
SLACK_WEBHOOK_URL=

# =============================================
# STORAGE
# =============================================
STORAGE_BACKEND=memory
