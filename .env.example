# YTAIMBot Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================
# БЮДЖЕТ: $0 — всі сервіси безкоштовні
# CLOUD:  GitHub Actions (free) або Oracle Cloud Free Tier
# ============================================================

# =============================================
# CORE PIPELINE
# =============================================
# false = реальна публікація на YouTube
YTAIMBOT_DRY_RUN=true
YTAIMBOT_SEED=42
YTAIMBOT_DATA_DIR=./data

# =============================================
# TREND ADAPTERS (Phase 1) — всі безкоштовні
# =============================================
# YouTube Data API v3 (безкоштовно: console.cloud.google.com)
# Порожньо = синтетичні дані (для тестування)
YOUTUBE_API_KEY=

# Google Trends geo (US, UA, GB, DE...) — безкоштовно через pytrends
# Порожньо = вимкнено Google Trends
GOOGLE_TRENDS_GEO=UA

# Вага адаптерів: GoogleTrends,YouTube (через кому)
ADAPTER_WEIGHTS=1.0,1.0

# TTL кешу трендів (секунди)
TREND_CACHE_TTL=900

# =============================================
# LLM — мозок проєкту (100% безкоштовно)
# =============================================
# ВАРІАНТ 1 (рекомендовано): Groq Cloud — 14 400 запитів/день FREE
# Реєстрація: console.groq.com (без кредитної картки)
GROQ_API_KEY=

# ВАРІАНТ 2: Google Gemini 1.5 Flash — 1 500 запитів/день FREE
# Реєстрація: aistudio.google.com/app/apikey (без кредитної картки)
GEMINI_API_KEY=

# Модель Groq (за замовчуванням)
LLM_MODEL=llama-3.1-8b-instant
# Модель Gemini (за замовчуванням)
GEMINI_MODEL=gemini-1.5-flash

# Мова скриптів
SCRIPT_LANGUAGE=uk
LLM_TOTAL_TOKENS=2048

# ВАРІАНТ 3 (опціонально): Ollama на Oracle Free Tier VPS
# Потребує ARM VM (4 OCPU, 24GB RAM) — безкоштовно назавжди
# OLLAMA_URL=http://your-oracle-vm:11434
# OLLAMA_MODEL=llama3.2:3b

# =============================================
# TTS — озвучення (всі безкоштовні)
# =============================================
# Пріоритет: edge-tts (unlimited) → ElevenLabs → Gemini TTS → TTSMaker

# edge-tts: Microsoft Edge голоси — БЕЗЛІМІТНО, без API ключа
TTS_LANGUAGE=uk
TTS_VOICE=uk-UA-OstapNeural
TTS_GENDER=male

# ElevenLabs: 10 000 символів/місяць FREE (найкраща якість)
# Реєстрація: elevenlabs.io (без кредитної картки)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# TTSMaker: 20 000 символів/тиждень FREE
# Реєстрація: ttsmaker.com
TTSMAKER_API_TOKEN=

# Пропустити певні сервіси (через кому)
# TTS_SKIP_SERVICES=elevenlabs

# =============================================
# STOCK FOOTAGE — стокові відео (безкоштовно)
# =============================================
# Pexels: 200 запитів/годину FREE, комерційне використання ✅
# Реєстрація: pexels.com/api
PEXELS_API_KEY=

# Pixabay: 100 запитів/хв FREE, комерційне використання ✅
# Реєстрація: pixabay.com/api/docs
PIXABAY_API_KEY=

# =============================================
# VIDEO ASSEMBLY — монтаж (безкоштовно)
# =============================================
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
VIDEO_YEAR=2026

# =============================================
# PUBLISHING — публікація на YouTube
# =============================================
# YouTube Data API v3 — 10 000 одиниць/день FREE
# OAuth2 client secret: console.cloud.google.com
YOUTUBE_CLIENT_SECRET_PATH=data/client_secret.json
YOUTUBE_TOKEN_PATH=data/token.json
YOUTUBE_CATEGORY_ID=28
YOUTUBE_DEFAULT_LANGUAGE=uk
MAX_UPLOADS_PER_DAY=1

# =============================================
# MONITORING (опціонально)
# =============================================
SLACK_WEBHOOK_URL=

# =============================================
# STORAGE
# =============================================
STORAGE_BACKEND=memory

