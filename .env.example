# YTAIMBot Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Pipeline settings
YTAIMBOT_DRY_RUN=true
YTAIMBOT_SEED=42
YTAIMBOT_DATA_DIR=./data

# YouTube Data API (leave blank to use synthetic source)
YOUTUBE_API_KEY=

# Optional: Hetzner / cloud storage
STORAGE_BACKEND=memory
